---
import '../styles/global.css';
const { title, description = 'Shantanu Pawar — projects and research in propulsion, plasma physics, and computational engineering.', page = '', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#ecece7" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <title>{title}</title>
  <link rel="icon" href={`${base}favicon.svg`} />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>

  <nav class="nav" aria-label="Site navigation">
    <div class="nav-inner">
      <a href={base} class="nav-logo" aria-label="Shantanu Pawar — home">SP<span style="color:var(--accent)">↗</span></a>
      <div class="nav-links" data-nav-links>
        <a href={base} aria-current={page === 'home' ? 'page' : undefined}>Home</a>
        <a href={`${base}projects/`} aria-current={page === 'projects' ? 'page' : undefined}>Projects</a>
        <a href={`${base}viot/`} aria-current={page === 'viot' ? 'page' : undefined}>VIOT</a>
        <a href={`${base}about/`} aria-current={page === 'about' ? 'page' : undefined}>About</a>
      </div>
      <button type="button" class="nav-toggle" data-nav-toggle aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
      <span class="nav-badge">Projects &amp; Research</span>
    </div>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <span class="footer-logo">S. Pawar</span>
      <span class="footer-copy">© 2026 Shantanu Pawar — PVG's COETM Pune</span>
      <span class="footer-open">Open Research</span>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var navToggle = document.querySelector('[data-nav-toggle]');
      var navLinks = document.querySelector('[data-nav-links]');
      if (navToggle && navLinks) {
        navToggle.addEventListener('click', function () {
          var open = navLinks.classList.toggle('is-open');
          navToggle.setAttribute('aria-expanded', String(open));
        });
        navLinks.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () {
            navLinks.classList.remove('is-open');
            navToggle.setAttribute('aria-expanded', 'false');
          });
        });
      }
    })();
  </script>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { TextPlugin } from 'gsap/TextPlugin';

    gsap.registerPlugin(ScrollTrigger, TextPlugin);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      document.querySelectorAll('[data-gsap]').forEach(el => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
      document.querySelectorAll('.char').forEach(el => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    } else {
      window.__gsap = gsap;
      window.__ST = ScrollTrigger;
      // Fail-safe: if GSAP freezes or errors out, ensure opacity becomes 1 after a short delay
      setTimeout(() => {
        document.querySelectorAll('.char').forEach(el => {
          if ((el as HTMLElement).style.opacity === '0') {
             (el as HTMLElement).style.opacity = '1';
             (el as HTMLElement).style.transform = 'none';
          }
        });
      }, 2000);
    }
  </script>
</body>
</html>
