---
import BaseLayout from '../../layouts/BaseLayout.astro';
import projects from '../../../data/projects.json';
import GroupedBarChart from '../../components/GroupedBarChart.astro';
import LineChart from '../../components/LineChart.astro';

export function getStaticPaths() {
  return (projects as any[])
    .filter((p) => p.published && p.id !== 'viot' && p.detail)
    .map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props as { project: any };
const d = project.detail;
const base = import.meta.env.BASE_URL;

const ICONS: Record<string, string> = {
  'n2o-rcs-icaetm': '<svg viewBox="0 0 28 28"><polyline points="2,20 8,20 8,6 12,6 12,24 16,24 16,10 20,10 20,20 26,20"/></svg>',
  'turbulence-closure-icmai': '<svg viewBox="0 0 28 28"><path d="M14 4a10 10 0 1 0 7 17"/><path d="M14 10a4.5 4.5 0 1 1-3.2 7.6"/></svg>',
  'smart-ambulance-gateway': '<svg viewBox="0 0 28 28"><polyline points="2,15 8,15 11,7 15,23 18,15 26,15"/><circle cx="23" cy="6" r="2"/></svg>',
  'sih-ohrc-toolkit': '<svg viewBox="0 0 28 28"><circle cx="13" cy="14" r="10"/><path d="M18 5.5a10 10 0 0 0 0 17 8 8 0 0 1 0-17z"/></svg>',
  'aerospace-multiphysics-pipeline': '<svg viewBox="0 0 28 28"><rect x="3" y="4" width="22" height="4.5"/><rect x="3" y="11.75" width="22" height="4.5"/><rect x="3" y="19.5" width="22" height="4.5"/></svg>',
  'qsim-studio': '<svg viewBox="0 0 28 28"><ellipse cx="14" cy="14" rx="10" ry="10"/><ellipse cx="14" cy="14" rx="10" ry="4"/><line x1="14" y1="14" x2="21" y2="5"/></svg>',
  'mmm-ansys-runner': '<svg viewBox="0 0 28 28"><path d="M2 8 L12 13 L12 15 L2 20 M26 8 L16 13 L16 15 L26 20"/></svg>',
  'profnet': '<svg viewBox="0 0 28 28"><circle cx="7" cy="8" r="3"/><circle cx="21" cy="8" r="3"/><circle cx="14" cy="21" r="3"/><line x1="9.5" y1="9.5" x2="18.5" y2="9.5"/><line x1="8" y1="10.8" x2="12.5" y2="18.5"/><line x1="20" y1="10.8" x2="15.5" y2="18.5"/></svg>',
  'manim-explainers': '<svg viewBox="0 0 28 28"><line x1="3" y1="24" x2="25" y2="24"/><line x1="3" y1="24" x2="3" y2="3"/><path d="M3 20 Q10 5 15 14 T25 7"/></svg>',
};
---
<BaseLayout title={`${project.title} — Shantanu Pawar`} page="projects" description={project.description}>
  <div class="container">
    <section class="hero">
      {ICONS[project.id] && <span class="hero-icon" data-hero-icon set:html={ICONS[project.id]} />}
      <p class="hero-eyebrow">{project.status}</p>
      <h1>{project.title}</h1>
      <p class="hero-sub">{d.tagline || project.description}</p>

      {project.tags?.length > 0 && (
        <div class="tag-row" style="margin-top: 1.5rem;">
          {project.tags.map((t: string) => <span class="tag-chip">{t}</span>)}
        </div>
      )}

      {(project.links?.repo || project.links?.demo || project.links?.paper) && (
        <div class="btn-row" style="margin-top: 2rem;">
          {project.links?.repo && <a class="btn-outline" href={project.links.repo} target="_blank" rel="noopener noreferrer">Repository</a>}
          {project.links?.demo && <a class="btn-outline" href={project.links.demo} target="_blank" rel="noopener noreferrer">Demo</a>}
          {project.links?.paper && <a class="btn-outline" href={project.links.paper} target="_blank" rel="noopener noreferrer">Paper</a>}
        </div>
      )}
    </section>

    {d.overview?.length > 0 && (
      <section>
        <div class="section-inner">
          <div class="section-label-col"><h2 class="label">Overview</h2></div>
          <div class="prose-block" data-reveal>
            {d.overview.map((p: string) => <p>{p}</p>)}
          </div>
        </div>
      </section>
    )}

    {d.dataset?.length > 0 && (
      <section>
        <div class="section-inner">
          <div class="section-label-col"><h2 class="label">Dataset</h2></div>
          <div class={`grid-cells cols-${Math.min(d.dataset.length, 3)}`}>
            {d.dataset.map((s: any) => (
              <div>
                <h3>{s.label}</h3>
                <p style="font-size:0.9rem;color:var(--muted);margin-top:0.5rem;line-height:1.5;">{s.value}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {d.chart && (
      <section>
        <div class="section-inner">
          <div class="section-label-col"><h2 class="label">Chart</h2></div>
          <div>
            {d.chart.type === 'bar' && (
              <GroupedBarChart categories={d.chart.categories} series={d.chart.series} caption={d.chart.caption} unit={d.chart.unit} />
            )}
            {d.chart.type === 'line' && (
              <LineChart xLabels={d.chart.xLabels} series={d.chart.series} caption={d.chart.caption} unit={d.chart.unit} />
            )}
          </div>
        </div>
      </section>
    )}

    {d.pipeline?.length > 0 && (
      <section>
        <div class="section-inner">
          <div class="section-label-col"><h2 class="label">Pipeline</h2></div>
          <div class="timeline" data-gsap="timeline">
            {d.pipeline.map((s: any, i: number) => (
              <div class="timeline-item">
                <span class="timeline-num">{String(i).padStart(2, '0')}</span>
                <div>
                  <p class="timeline-title">{s.step}</p>
                  <p class="timeline-body">{s.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {d.architecture?.length > 0 && (
      <section>
        <div class="section-inner">
          <div class="section-label-col"><h2 class="label">Architecture</h2></div>
          <div class="table-wrap" data-gsap="table">
            <table>
              <thead><tr><th>Stage</th><th>Status</th><th>Detail</th></tr></thead>
              <tbody>
                {d.architecture.map((a: any) => (
                  <tr>
                    <td>{a.stage}</td>
                    <td class={a.status?.toLowerCase().includes('implemented') ? 'td-navy' : 'td-muted'}>{a.status}</td>
                    <td>{a.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )}

    {d.resultsTable && (
      <section>
        <div class="section-inner">
          <div class="section-label-col"><h2 class="label">Results</h2></div>
          <div>
            <p class="label">{d.resultsTable.caption}</p>
            <div class="table-wrap" data-gsap="table">
              <table>
                <thead><tr>{d.resultsTable.headers.map((h: string) => <th>{h}</th>)}</tr></thead>
                <tbody>
                  {d.resultsTable.rows.map((row: string[]) => (
                    <tr>{row.map((cell: string) => <td>{cell}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    )}

    {d.resultsTable2 && (
      <section>
        <div class="section-inner">
          <div class="section-label-col"><h2 class="label">Comparison</h2></div>
          <div>
            <p class="label">{d.resultsTable2.caption}</p>
            <div class="table-wrap" data-gsap="table">
              <table>
                <thead><tr>{d.resultsTable2.headers.map((h: string) => <th>{h}</th>)}</tr></thead>
                <tbody>
                  {d.resultsTable2.rows.map((row: string[]) => (
                    <tr>{row.map((cell: string) => <td>{cell}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    )}

    {d.findings?.length > 0 && (
      <section>
        <div class="callout" data-gsap="callout">
          <p class="accent-label">Key Findings</p>
          <h2>What the work shows</h2>
          <div class="findings-list">
            {d.findings.map((f: string) => <p>{f}</p>)}
          </div>
        </div>
      </section>
    )}

    <section>
      <div class="section-inner">
        <div class="section-label-col"><h2 class="label">Stack</h2></div>
        <div>
          {project.tech?.length > 0 && (
            <div class="tag-row">
              {project.tech.map((t: string) => <span class="tag-chip">{t}</span>)}
            </div>
          )}
          <div class="btn-row" style="margin-top: 2rem;">
            <a class="btn-outline" href={`${base}projects/`}>All projects</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { animate, eases } from 'animejs';

    const icon = document.querySelector('[data-hero-icon]') as HTMLElement | null;
    if (icon) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        icon.style.opacity = '1';
      } else {
        animate(icon, {
          opacity: [0, 1],
          scale: [0.6, 1],
          rotate: [-8, 0],
          duration: 650,
          ease: eases.outElastic(1, 0.6),
        });
      }
    }
  </script>
</BaseLayout>
