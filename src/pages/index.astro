ition:relative;z-index:2}h2{font-size:clamp(42px,4.6vw,72px);line-height:1.04;font-weight:500;letter-spacing:-.055em;margin:0 0 32px}h2 em{font-style:normal;color:#df6c47}.copy>p:not(.eyebrow){font-size:15px;line-height:1.8;color:#697670;max-width:460px}.copy>p.large-copy{font-size:21px;line-height:1.5;color:inherit}.signature{font-size:20px;margin-top:40px;letter-spacing:-.6px}.signature span{display:block;font-size:10px;color:#78847b;margin-top:9px;letter-spacing:.4px}.research,.approach{color:#f0f2e9;background:linear-gradient(90deg,#101c24 0%,#101c24ee 35%,transparent 80%)}.research .eyebrow,.approach .eyebrow{color:#a8b9b8}.research .copy>p:not(.large-copy):not(.eyebrow),.approach .copy p{color:#aabbbb}.research-facts{display:flex;gap:50px;margin:32px 0}.research-facts strong{display:block;font-size:36px;font-weight:400;letter-spacing:-1px}.research-facts span{display:block;font-size:10px;color:#a8b9b8;margin-top:8px}details{border-top:1px solid #829e9b55;padding-top:20px;font-size:13px}summary{cursor:pointer;display:flex;justify-content:space-between;list-style:none}summary span{color:#ed885f}details p{line-height:1.7;color:#b7c8c8}.method{display:flex;gap:25px;margin:30px 0}.method>span{font-family:Consolas,monospace;font-size:10px;color:#df8562;padding-top:5px}.method h3{font-size:19px;font-weight:400;letter-spacing:-.4px;margin:0 0 9px}.method p{font-size:14px;line-height:1.65;margin:0;max-width:395px}.contact{min-height:100svh;padding-bottom:150px}.contact .copy{width:60%;max-width:740px}.contact-link{font-size:19px;display:inline-flex;gap:60px;margin-top:25px;padding-bottom:15px;border-bottom:1px solid #7d8c82}.contact-link span{color:#d9562e}.replay{display:block;width:fit-content;font-size:11px;color:#69766b;margin-top:30px}footer{position:absolute;bottom:30px;left:5.5%;right:5.5%;display:flex;justify-content:space-between;font-size:10px;color:#627266}.flight-status{position:fixed;bottom:76px;right:5.5%;z-index:8;display:flex;align-items:center;gap:10px;font-family:Consolas,monospace;font-size:9px;color:#344c40}.status-dot{width:5px;height:5px;background:#d65c32;border-radius:50%}.phase-count{margin-left:15px;color:#6d7e72}.flight-status button{background:transparent;border:0;border-left:1px solid #8a9b8855;color:inherit;font-size:9px;padding:5px 0 5px 12px;cursor:pointer}.flight-status.in-space{color:#c5d8d2}.in-space .phase-count{color:#a6bcb3}@media(min-width:1600px){.copy{margin-left:5%}.flight-world{--rocket-right:14%}}@media(max-width:760px){header{height:76px;padding:0 6%}nav{gap:18px;font-size:11px}.header-link{display:none}.chapter{padding:110px 7% 80px;min-height:115svh;align-items:flex-start}.intro{min-height:100svh;padding-top:120px}.intro-copy{width:100%}h1{font-size:clamp(42px,8.6vw,64px);letter-spacing:-.055em}.eyebrow{font-size:8px;letter-spacing:1.2px;margin-bottom:22px}.lede{font-size:13px;max-width:290px}.text-link{font-size:10px;gap:18px}.flight-world{--rocket-right:-2%;--rocket-width:24vh}.rocket-wrap{height:56vh;bottom:1vh;opacity:.9}.orbit{right:-400px}.orbit-two{right:-300px}.ground{width:100%}.vehicle-label{display:none}.hero-bottom{bottom:26px;font-size:7px}.hero-bottom>span:first-child{max-width:120px;line-height:1.8}.copy{width:78%;max-width:500px}h2{font-size:41px}.copy>p:not(.eyebrow){font-size:13px;line-height:1.7}.copy>p.large-copy{font-size:18px}.research .copy,.approach .copy{width:82%}.research-facts{gap:27px}.research-facts strong{font-size:29px}.research-facts span{font-size:8px}.method{gap:15px;margin:25px 0}.method h3{font-size:16px}.method p{font-size:12px}.contact .copy{width:95%}.contact{min-height:100svh}.contact h2{font-size:40px}.contact-link{font-size:16px}.flight-status{bottom:60px;right:6%;font-size:8px;gap:7px}.phase-count{display:none}.flight-status button{font-size:8px}footer{font-size:8px;gap:20px;bottom:20px}footer span:last-child{max-width:130px;text-align:right}.planet{bottom:-45vh;width:200vw;height:100vh}.research,.approach{background:linear-gradient(90deg,#101c24f5 0%,#101c24e0 48%,transparent 90%)}.about .copy{background:linear-gradient(90deg,#ecece7f0,#ecece7b0,transparent)}.contact .copy{background:linear-gradient(90deg,#ecece7ec,#ecece7b0,transparent)}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.research,.approach{color:#202b30}.research .eyebrow,.approach .eyebrow,.research .copy>p:not(.large-copy):not(.eyebrow),.approach .copy p,.research-facts span,.method p,details p{color:#57675e}.research,.approach{background:transparent}.chapter{min-height:90svh}}
/* Secondary loops never transform the scroll-controlled nozzle or wing hinges. */
.vent,.rcs,.signal-ring,.pad-dust{opacity:0}
.vent-puff{fill:#c5d0cd}.signal-ring{transform-box:fill-box;transform-origin:center}
.pad-light{position:absolute;top:17px;width:3px;height:3px;background:#d5754d;border-radius:50%}.pad-light-left{left:10%}.pad-light-right{right:10%}
.pad-dust{position:absolute;inset:0;pointer-events:none}.pad-dust i{position:absolute;left:48%;top:8px;width:24px;height:9px;border-radius:50%;background:#aeb9b0;filter:blur(3px)}
@media(prefers-reduced-motion:no-preference){
.flight-active .vehicle-beacon,.flight-active .pad-light{animation:beacon-glow 3.7s ease-in-out infinite}
.flight-active[data-flight="preflight"] .vent{opacity:1}
.flight-active[data-flight="preflight"] .vent-puff{animation:vent-drift 3.8s ease-out infinite}
.flight-active .vent-late{animation-delay:1.9s!important}
.flight-active[data-flight="ascent"] .flame-core,.flight-active[data-flight="landing"] .flame-core{animation:engine-shimmer .22s ease-in-out infinite alternate}
.flight-active[data-flight="separation"] .rcs,.flight-active[data-flight="orbit"] .rcs{opacity:1}
.flight-active .rcs-puff{animation:attitude-puff 5s ease-out infinite}
.flight-active[data-flight="orbit"] .satellite-drift{animation:satellite-float 7s ease-in-out infinite alternate}
.flight-active[data-flight="orbit"] .sat-beacon{animation:beacon-glow 2.8s ease-in-out infinite}
.flight-active[data-flight="orbit"] .signal-ring{animation:radio-pulse 4.5s ease-out infinite}
.flight-active .signal-late{animation-delay:2.25s!important}
.flight-active[data-flight="landing"] .pad-dust{opacity:.45}
.flight-active[data-flight="landing"] .pad-dust i{animation:dust-drift 2.7s ease-out infinite}
.flight-active .pad-dust i:nth-child(2){animation-delay:-1.3s;--dust-direction:-1}
.flight-active .pad-dust i:nth-child(3){animation-delay:-.7s}
.flight-active .pad-dust i:nth-child(4){animation-delay:-2s;--dust-direction:-1}
}
@keyframes beacon-glow{0%,65%,100%{opacity:.3}75%,82%{opacity:1}}
@keyframes vent-drift{0%{transform:translate(0,0) scale(.5);opacity:0}15%{opacity:.5}100%{transform:translate(28px,-9px) scale(3);opacity:0}}
@keyframes engine-shimmer{from{opacity:.65}to{opacity:1}}
@keyframes attitude-puff{0%,8%,18%,100%{opacity:0}10%,13%{opacity:.5}}
@keyframes satellite-float{from{transform:translate(0,0)}to{transform:translate(-2px,3px)}}
@keyframes radio-pulse{0%{transform:scale(1);opacity:0}10%{opacity:.4}100%{transform:scale(4);opacity:0}}
@keyframes dust-drift{0%{transform:translateX(0) scale(.4);opacity:0}20%{opacity:.45}100%{transform:translateX(calc(85px * var(--dust-direction,1))) scale(2.5);opacity:0}}
</style>
