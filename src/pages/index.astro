---
import BaseLayout from '../layouts/BaseLayout.astro';
import allProjects from '../../data/projects.json';
import profile from '../../data/profile.json';

const base = import.meta.env.BASE_URL;
const published = (allProjects as any[]).filter((p) => p.published);
---
<BaseLayout title="Shantanu Pawar — Projects & Research" page="home">
  <div class="container">
    <section class="hero">
      <p class="hero-eyebrow">Mechanical Engineering — PVG's COETM, Pune</p>
      <h1 data-anime="hero-title">Shantanu Pawar</h1>
      <p class="hero-sub">
        Propulsion, plasma physics, and computational engineering — from a GPU plasma-simulation
        research program to embedded systems, quantum computing, and structural analysis.
        This page indexes the work; each project links to its own writeup, repo, or dataset.
      </p>
      <div class="hero-meta">
        <div class="hero-stat">
          <div class="hero-stat-val">{published.length}</div>
          <div class="hero-stat-label">Active Projects</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-val">3</div>
          <div class="hero-stat-label">Conference Submissions</div>
        </div>
      </div>
      <div class="btn-row" style="margin-top: 2.5rem;">
        <a class="btn-outline btn-outline--accent" href={`${base}viot/`}>Flagship: VIOT research</a>
        <a class="btn-outline" href={`${base}about/`}>About &amp; contact</a>
      </div>
    </section>

    <section style="border-top: none; padding-top: 0;">
      <div class="section-inner">
        <div class="section-label-col"><h2 class="label">Portfolio</h2></div>
        <div>
          <h3 class="section-title">Projects &amp; research</h3>
          <div class="project-grid" data-anime="project-grid">
            {published.map((p, i) => {
              const href = p.links?.detail
                ? (p.links.detail.startsWith('/') ? `${base}${p.links.detail.slice(1)}` : p.links.detail)
                : (p.links?.repo || `${base}projects/`);
              const isExternal = href.startsWith('http');
              return (
                <a class="project-card" data-anime-item href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
                  <span class="project-card-mark">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{p.title}</h3>
                  <p>{p.description}</p>
                  {p.tags?.length > 0 && (
                    <div class="tag-row">
                      {p.tags.slice(0, 2).map((t: string) => <span class="tag-chip">{t}</span>)}
                    </div>
                  )}
                  {p.status && <span class="project-card-status">{p.status}</span>}
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { animate, stagger, eases } from 'animejs';

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const title = document.querySelector('[data-anime="hero-title"]');
      if (title) {
        animate(title, {
          opacity: [0, 1],
          translateY: [24, 0],
          duration: 900,
          ease: eases.outExpo,
        });
      }

      const grid = document.querySelector('[data-anime="project-grid"]');
      if (grid) {
        const cards = grid.querySelectorAll('[data-anime-item]');
        const io = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            animate(cards, {
              opacity: [0, 1],
              translateY: [32, 0],
              delay: stagger(70, { from: 'first' }),
              duration: 700,
              ease: eases.outExpo,
            });
            io.disconnect();
          }
        }, { threshold: 0.1 });
        io.observe(grid);
        cards.forEach((card) => {
          card.addEventListener('mouseenter', () => {
            animate(card, { translateY: -6, duration: 260, ease: eases.outQuad });
          });
          card.addEventListener('mouseleave', () => {
            animate(card, { translateY: 0, duration: 260, ease: eases.outQuad });
          });
        });
      }
    }
  </script>
</BaseLayout>
